# deploy_scripts.sh / Deploy-Scripts.ps1 のサンプルリストファイル
#
# 形式:
#   CONF, <filename>              config/default/<filename>       → <opt_root_dir>/config/<filename>
#   SRC,  <repo_filepath>         <repo_filepath>                 → <opt_root_dir>/bin/<basename>
#   LIB,  linux/<f>|windows/<f>   scripts_<platform>/lib/<file>  → <opt_root_dir>/lib/<platform>/<file>
#
# env が指定された場合、CONF は default を配備した後 config/<env>/ で上書き。
# スペースはカンマの前後で自由に入れてよい。行頭 # はコメント。
#
# このサンプルでは全エントリをコメントアウトしている。実運用時は本ファイルを
# 編集するか、環境別に config/<env>/deploy_scripts.lst を作って
# deploy_scripts.conf の PathList を上書きすること。

# --- 設定ファイル ---
# CONF, global.conf
# CONF, ec2ctl.conf
# CONF, backup_ami.conf
# CONF, rotate_log.conf
# CONF, s3upload.conf
# CONF, tomcatctl.conf
# CONF, sqlserverctl.conf

# --- 共通ライブラリ（Linux Bash スクリプトを使う場合は必須） ---
# LIB, linux/logging.sh
# LIB, linux/config.sh

# --- Linux スクリプト ---
# SRC, scripts_linux/aws/ec2ctl.sh
# SRC, scripts_linux/aws/backup_ami.sh
# SRC, scripts_linux/aws/backup_ebs_snapshot.sh
# SRC, scripts_linux/aws/s3upload.sh
# SRC, scripts_linux/os/rotate_log.sh
# SRC, scripts_linux/tomcat/tomcatctl.sh
# SRC, scripts_linux/sqlserver/sqlserverctl.sh

# --- Linux スクリプト（サーバー情報収集） ---
# SRC, scripts_linux/os/get_server_info.sh

# --- Windows スクリプト ---
# SRC, scripts_windows/aws/Ec2Ctl.ps1
# SRC, scripts_windows/aws/Backup-Ami.ps1
# SRC, scripts_windows/aws/Backup-EbsSnapshot.ps1
# SRC, scripts_windows/aws/S3Upload.ps1
# SRC, scripts_windows/os/Rotate-Log.ps1
# SRC, scripts_windows/tomcat/TomcatCtl.ps1
# SRC, scripts_windows/sqlserver/SqlServerCtl.ps1

# --- Windows スクリプト（サーバー情報収集・比較） ---
# SRC, scripts_windows/os/Get-ServerInfo.ps1
# SRC, scripts_windows/os/Compare-ServerInfo.ps1
