# deploy_scripts.sh / Deploy-Scripts.ps1 のサンプルリストファイル
#
# 形式:
#   CONF, <filename>       config/default/<filename> → <opt_root_dir>/config/<filename>
#   SRC,  <repo_filepath>  scripts/<repo_filepath>   → <opt_root_dir>/bin/<basename>
#
# env が指定された場合、CONF は default を配備した後 config/<env>/ で上書き。
# スペースはカンマの前後で自由に入れてよい。行頭 # はコメント。
#
# このサンプルでは全エントリをコメントアウトしている。実運用時は本ファイルを
# 編集するか、環境別に config/<env>/deploy_scripts.lst を作って
# deploy_scripts.conf の PathList を上書きすること。

# --- 設定ファイル ---
# CONF, ops.conf
# CONF, ec2ctl.conf
# CONF, backup_ami.conf
# CONF, rotate_log.conf
# CONF, s3upload.conf
# CONF, tomcatctl.conf
# CONF, sqlserverctl.conf

# --- Linux スクリプト ---
# SRC, aws/bash/ec2ctl.sh
# SRC, aws/bash/backup_ami.sh
# SRC, aws/bash/backup_ebs_snapshot.sh
# SRC, aws/bash/s3upload.sh
# SRC, linux/bash/rotate_log.sh
# SRC, tomcat/bash/tomcatctl.sh
# SRC, sqlserver/bash/sqlserverctl.sh

# --- Windows スクリプト ---
# SRC, aws/powershell/Ec2Ctl.ps1
# SRC, aws/powershell/Backup-Ami.ps1
# SRC, aws/powershell/Backup-EbsSnapshot.ps1
# SRC, aws/powershell/S3Upload.ps1
# SRC, windows/powershell/Rotate-Log.ps1
# SRC, tomcat/powershell/TomcatCtl.ps1
# SRC, sqlserver/powershell/SqlServerCtl.ps1
