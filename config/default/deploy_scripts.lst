# deploy_scripts.sh / Deploy-Scripts.ps1 のサンプルリストファイル
#
# 形式: <name> [Key=Value ...]
# 受け付けるキー: Mode, Path, Conf, Tests
#
# Mode:
#   script-only   本体のみ
#   with-config   本体 + 対応する <env>/<name>.conf + ops.conf（既定）
#   with-tests    本体 + 対応するテスト
#   all           本体 + conf + tests
#
# 拡張子は省略可（Linux なら .sh、Windows なら .ps1 を自動補完）。
# Windows 側は snake_case → PascalCase の変換も試行する：
#   'backup_ami' → 'Backup-Ami.ps1'
#
# このサンプルでは全エントリをコメントアウトしている。実運用時は本ファイルを
# 編集するか、環境別に config/<env>/deploy_scripts.lst を作って
# deploy_scripts.conf の PathList を上書きすること。

# --- AWS バックアップ ---
# backup_ami
# backup_ebs_snapshot

# --- AWS ライフサイクル ---
# ec2ctl

# --- AWS S3 ---
# s3upload

# --- ログ運用 ---
# rotate_log

# --- ミドルウェア（必要なサーバだけに配備） ---
# tomcatctl
# sqlserverctl

# --- 行内オプションの例：tests も付けて配備 ---
# ec2ctl  Mode=all

# --- 明示パス指定の例（Path で名前解決を上書き） ---
# my_special  Path=scripts/aws/bash/my_special.sh

# --- conf 名のエイリアス例 ---
# my_script  Conf=shared.conf  Tests=my_script_smoke.bats
