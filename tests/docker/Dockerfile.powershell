# ============================================================================
# Dockerfile.powershell  -  PowerShell 7 on Ubuntu for PS script testing
#
# NOTE: Windows-specific cmdlets (Get-Service, Get-CimInstance, etc.)
#       are not available on Linux. We mock them in TestHelpers.psm1 so
#       most controller tests still run cross-platform.
#
#       Tests verify:
#         - Module import (Logging.psm1, Config.psm1)
#         - Syntax parsing of all .ps1/.psm1
#         - Argument validation and exit-code conventions
#         - lib / config resolution (walk-up, OPS_LIB, OPS_CONFIG_DIR)
#         - Controllers via mocked Get-Service / Start-Service / Stop-Service
# ============================================================================
FROM mcr.microsoft.com/powershell:7.4-ubuntu-22.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Pester 5+ (Pester 5.5 / 5.6 が安定版)
RUN pwsh -NoProfile -Command "Install-Module Pester -MinimumVersion 5.5.0 -Force -Scope AllUsers -SkipPublisherCheck"

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

WORKDIR /repo
