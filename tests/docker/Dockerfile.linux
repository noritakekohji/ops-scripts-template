# ============================================================================
# Dockerfile.linux  -  Ubuntu 22.04 image for bash tool/script testing
# ============================================================================
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core shells / interpreters
    bash \
    python3 \
    # Network tools (for check_network_connectivity.sh)
    iputils-ping \
    iproute2 \
    net-tools \
    bind9-dnsutils \
    traceroute \
    netcat-openbsd \
    curl \
    # System info tools (for get_server_info.sh)
    util-linux \
    procps \
    # File tools
    gzip \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

WORKDIR /repo
