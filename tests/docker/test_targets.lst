# Network check test targets (for Docker container environment)
# Docker has outbound internet access by default.
# Ping (ICMP) requires --cap-add=NET_RAW — included via run_tests.sh

# ---- TCP reachable (expected: ok) ----
google.com,   443, ok, Google HTTPS
google.com,    80, ok, Google HTTP

# ---- TCP blocked (expected: ng) ----
google.com,    22, ng, SSH (should be refused)
google.com,  9999, ng, Unknown port (should fail)

# ---- Ping only ----
8.8.8.8,        -, ok, Google DNS (ICMP)
